# Server
PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGIN=

# Database (Supabase / Postgres)
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# App JWT (backend-issued token used on every protected request)
JWT_SECRET=
APP_JWT_TTL=30m

# Firebase Admin — service account. NEVER commit real values.
# Option A: path to the service-account JSON file (preferred — no newline escaping).
# FIREBASE_SERVICE_ACCOUNT_PATH or the standard GOOGLE_APPLICATION_CREDENTIALS work.
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: individual fields (FIREBASE_PRIVATE_KEY may contain \n escapes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
